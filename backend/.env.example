# Todos os valores sensíveis abaixo são placeholders fictícios.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://login:SUBSTITUA_POR_SEGREDO_LOCAL@localhost:5432/login
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:3001
ENCRYPTION_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
HMAC_KEY=SUBSTITUA_POR_OUTROS_64_CARACTERES_HEXADECIMAIS
KEY_VERSION=v1
MASTER_USERNAME=Ronald
MASTER_EMAIL=operador@example.invalid
MASTER_INITIAL_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_NAO_VERSIONADA
TRUST_PROXY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
LOGIN_IP_LIMIT=10
API_IP_LIMIT=100
ACCOUNT_FAILURE_LIMIT=3
ACCOUNT_WINDOW_MS=900000
COOLDOWN_BASE_MS=300000
COOLDOWN_MAX_MS=1800000
MASTER_DEVICE_DAYS=30
MASTER_COOLDOWN_BASE_MS=60000
MASTER_COOLDOWN_MAX_MS=300000
TURNSTILE_THRESHOLD=2
SESSION_HOURS=8
PASSWORD_HASH_CONCURRENCY=4

# Redis de filas: segredo independente, 32 bytes aleatórios em 64 dígitos hexadecimais.
EMAIL_QUEUE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS

# Consumo SMTP opt-in. Sem configuração, manter false; nenhum envio é simulado.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SUBSTITUA_POR_USUARIO_SMTP
SMTP_PASSWORD=SUBSTITUA_POR_SEGREDO_SMTP
EMAIL_FROM=sender@example.invalid
