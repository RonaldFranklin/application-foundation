generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  platformAdmin PlatformAdmin?
  platformInvitations PlatformAdminInvitation[]
  id                 String         @id @default(uuid())
  username           String
  emailVerifiedAt    DateTime?
  emailVerification  EmailVerification?
  email              String
  usernameIndex      String         @unique
  emailIndex         String         @unique
  master             Boolean        @default(false)
  passwordHash       String
  mustChangePassword Boolean        @default(false)
  totpSecret         String?
  totpVerified       Boolean        @default(false)
  lastTotpStep       BigInt         @default(-1)
  createdAt          DateTime       @default(now())
  invitationsCreated OrganizationInvitation[]
  memberships        OrganizationMember[]
  sessions           Session[]
  recoveryCodes      RecoveryCode[]
  masterDevices      MasterDevice[]
}

model Session {
  digest    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model RecoveryCode {
  digest String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateState {
  key          String     @id
  hits         DateTime[]
  cycles       Int        @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime   @updatedAt

  @@index([updatedAt])
}

// Admission capability only: never accepted as an authenticated session.
model MasterDevice {
  digest    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum OrganizationRole {
  MEMBER
  ORGANIZATION_ADMIN
}

// Partial unique index on userId WHERE deletedAt IS NULL is maintained by SQL migration.
model OrganizationMember {
  deletedAt DateTime?
  organizationId String
  userId String
  role OrganizationRole @default(MEMBER)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, deletedAt, role])
}

model Organization {
  invitations OrganizationInvitation[]
  deletedAt DateTime?
  permissions OrganizationPermissionGrant[]
  members OrganizationMember[]
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt, id])
  @@index([active, createdAt, id])
  @@index([deletedAt, createdAt, id])
}

enum OrganizationPermission {
  ORGANIZATION_READ @map("organization.read")
  ORGANIZATION_UPDATE @map("organization.update")
  MEMBERS_READ @map("members.read")
  MEMBERS_CREATE @map("members.create")
  MEMBERS_LINK @map("members.link")
  MEMBERS_ROLES @map("members.roles")
  MEMBERS_REMOVE @map("members.remove")
  PERMISSIONS_MANAGE @map("permissions.manage")
}
model OrganizationPermissionGrant {
  organizationId String
  role OrganizationRole @default(MEMBER)
  permission OrganizationPermission
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([organizationId, role, permission])
}

model EmailVerification {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  id String @unique
  digest String?
  emailFingerprint String
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  deliveredAt DateTime?
  requests DateTime[]
}

model OrganizationInvitation {
  expiryAuditedAt DateTime?
  id String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email String
  emailFingerprint String
  role OrganizationRole
  digest String
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  deliveredAt DateTime?

  @@index([expiryAuditedAt, expiresAt])
  @@unique([organizationId, emailFingerprint])
  @@index([organizationId, expiresAt])
}

// Correlatable identifiers and allowlisted metadata are encrypted together by Vault.
model AuditEvent {
  id String @id @default(uuid())
  occurredAt DateTime @default(now())
  action String
  outcome String
  resourceType String
  details String
  organizationIndex String?

  @@index([organizationIndex, occurredAt, id])

  @@index([occurredAt, id])
  @@index([action, occurredAt])
}

// Separate eligibility; never changes User.master or organization roles.
model PlatformAdmin {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  permissions String[]
  createdAt DateTime @default(now())
}

model PlatformAdminInvitation {
  id String @id
  email String
  emailFingerprint String @unique
  digest String
  permissions String[]
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  deliveredAt DateTime?
  attempts Int @default(0)
  @@index([expiresAt])
}
